{
  "name": "2048",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run test:logic && playwright test",
    "verify:visual": "playwright test tests/visual.spec.ts",
    "inspect:canvas": "node scripts/inspect-threejs-canvas.mjs",
    "test:logic": "esbuild src/game/Board.ts --bundle --format=esm --outfile=.tmp/board.mjs --log-level=warning && node --test tests/board.test.mjs"
  },
  "dependencies": {
    "lil-gui": "^0.21.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.0",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.184.1",
    "esbuild": "^0.28.2",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.2.9",
    "@rolldown/binding-win32-x64-msvc": "1.2.9"
  }
}
